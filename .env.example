CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_GATEWAY_ID=default
CLOUDFLARE_API_TOKEN=
FLUXCREATE_CLOUDFLARE_MUSIC=false
FLUXCREATE_CLOUDFLARE_FALLBACK=false
FLUX_CLOUDFLARE_TEXT_MODELS={}
