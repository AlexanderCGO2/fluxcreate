# Optional server configuration. All credential values are intentionally blank.
# Do not put real values in this tracked file.
# Prefer General settings for a personal browser connection.
# This file is not loaded automatically; explicitly load/export server variables.

AI_GATEWAY_API_KEY=
FLUXCREATE_CONNECTION_SECRET=

# Optional model selection; confirm actual account/catalog support first.
# FLUXINI_MODEL=provider/model-id

